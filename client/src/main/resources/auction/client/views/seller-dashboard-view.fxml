<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="760.0" prefWidth="1200.0"
            style="-fx-background-color: linear-gradient(to bottom, #2196F3, #1976D2); -fx-padding: 15;"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="auction.client.controllers.SellerDashboardController">

    <top>
        <HBox alignment="CENTER_LEFT" style="-fx-background-color: white; -fx-padding: 15 25; -fx-background-radius: 8;">
            <BorderPane.margin>
                <Insets bottom="15.0"/>
            </BorderPane.margin>
            <Label text="🏪 KÊNH NGƯỜI BÁN (SELLER DASHBOARD)" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #1976D2;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="🔄 Làm mới danh sách" onAction="#handleRefreshMyAuctions"
                    style="-fx-background-color: #FF6F00; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 15; -fx-background-radius: 4; -fx-cursor: hand;"/>
        </HBox>
    </top>

    <center>
        <VBox spacing="15.0">

            <VBox spacing="15.0" style="-fx-background-color: white; -fx-padding: 20 25; -fx-background-radius: 8;">
                <Label text="📝 Đăng ký phiên đấu giá mới" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1976D2;"/>
                <Separator style="-fx-padding: 0;"/>

                <GridPane hgap="25.0" vgap="15.0">
                    <Label text="Tên sản phẩm:" style="-fx-font-weight: bold; -fx-text-fill: #757575;" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                    <TextField fx:id="productNameField" promptText="Nhập tên sản phẩm..."
                               style="-fx-padding: 8 12; -fx-border-color: #BDBDBD; -fx-border-radius: 4; -fx-background-radius: 4;"
                               GridPane.columnIndex="1" GridPane.rowIndex="0" prefWidth="280.0"/>

                    <Label text="Giá khởi điểm ($):" style="-fx-font-weight: bold; -fx-text-fill: #757575;" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                    <TextField fx:id="startingPriceField" promptText="Ví dụ: 1500"
                               style="-fx-padding: 8 12; -fx-border-color: #BDBDBD; -fx-border-radius: 4; -fx-background-radius: 4;"
                               GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                    <Label text="Loại vật phẩm:" style="-fx-font-weight: bold; -fx-text-fill: #757575;" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
                    <ComboBox fx:id="itemTypeComboBox" promptText="Chọn loại..." prefWidth="220.0"
                              style="-fx-padding: 4 8; -fx-border-color: #BDBDBD; -fx-border-radius: 4; -fx-background-radius: 4; -fx-background-color: white;"
                              GridPane.columnIndex="3" GridPane.rowIndex="0"/>

                    <Label text="Thời lượng (phút):" style="-fx-font-weight: bold; -fx-text-fill: #757575;" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
                    <TextField fx:id="durationMinutesField" promptText="Ví dụ: 60"
                               style="-fx-padding: 8 12; -fx-border-color: #BDBDBD; -fx-border-radius: 4; -fx-background-radius: 4;"
                               GridPane.columnIndex="3" GridPane.rowIndex="1"/>

                    <Label text="Mô tả chi tiết:" style="-fx-font-weight: bold; -fx-text-fill: #757575;" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                    <TextArea fx:id="descriptionArea" wrapText="true" prefRowCount="3" promptText="Viết mô tả ngắn gọn về sản phẩm..."
                              style="-fx-border-color: #BDBDBD; -fx-border-radius: 4; -fx-background-radius: 4;"
                              GridPane.columnIndex="1" GridPane.columnSpan="3" GridPane.rowIndex="2"/>
                </GridPane>

                <HBox alignment="CENTER_RIGHT">
                    <Button text="🚀 Đăng ký đấu giá" onAction="#handleCreateAuction"
                            style="-fx-background-color: #1976D2; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14px; -fx-padding: 10 24; -fx-background-radius: 4; -fx-cursor: hand;"/>
                </HBox>
            </VBox>

            <VBox spacing="15.0" VBox.vgrow="ALWAYS" style="-fx-background-color: white; -fx-padding: 20 25; -fx-background-radius: 8;">
                <Label text="📦 Danh sách sản phẩm của tôi" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1976D2;"/>
                <Separator style="-fx-padding: 0;"/>

                <TableView fx:id="myAuctionsTable" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent; -fx-control-inner-background: white; -fx-border-color: transparent;">
                    <columns>
                        <TableColumn fx:id="myProductColumn" prefWidth="280.0" text="Tên sản phẩm"/>
                        <TableColumn fx:id="myTypeColumn" prefWidth="150.0" text="Loại"/>
                        <TableColumn fx:id="myPriceColumn" prefWidth="150.0" text="Giá hiện tại ($)"/>
                        <TableColumn fx:id="myStatusColumn" prefWidth="150.0" text="Trạng thái"/>
                        <TableColumn fx:id="myEndTimeColumn" prefWidth="220.0" text="Kết thúc lúc"/>
                    </columns>
                </TableView>

                <HBox spacing="15.0" alignment="CENTER_LEFT">
                    <Button fx:id="btnEdit" text="✏️ Sửa" onAction="#handleEditAuction"
                            style="-fx-background-color: white; -fx-text-fill: #1976D2; -fx-border-color: #1976D2; -fx-border-radius: 4; -fx-background-radius: 4; -fx-font-weight: bold; -fx-padding: 8 20; -fx-cursor: hand;"/>
                    <Button fx:id="btnUpdateStatus" text="⚡ Cập nhật trạng thái" onAction="#handleUpdateStatus"
                            style="-fx-background-color: white; -fx-text-fill: #1976D2; -fx-border-color: #1976D2; -fx-border-radius: 4; -fx-background-radius: 4; -fx-font-weight: bold; -fx-padding: 8 20; -fx-cursor: hand;"/>

                    <Region HBox.hgrow="ALWAYS" />

                    <Button fx:id="btnDelete" text="🗑️ Xóa" onAction="#handleDeleteAuction"
                            style="-fx-background-color: #FEF2F2; -fx-text-fill: #DC2626; -fx-border-color: #F87171; -fx-border-radius: 4; -fx-background-radius: 4; -fx-font-weight: bold; -fx-padding: 8 20; -fx-cursor: hand;"/>
                </HBox>
            </VBox>
        </VBox>
    </center>

    <bottom>
        <HBox spacing="10.0" alignment="CENTER_RIGHT" style="-fx-background-color: white; -fx-padding: 15 25; -fx-background-radius: 8;">
            <BorderPane.margin>
                <Insets top="15.0"/>
            </BorderPane.margin>
            <Button text="⬅️ Quay lại danh sách vật phẩm" onAction="#handleOpenMarket"
                    style="-fx-background-color: #FF6F00; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14px; -fx-padding: 10 20; -fx-background-radius: 4; -fx-cursor: hand;"/>
        </HBox>
    </bottom>

</BorderPane>