<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="680.0" prefWidth="1180.0"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="auction.client.controllers.AdminDashboardController">
    <top>
        <VBox spacing="10.0" style="-fx-padding: 12;">
            <Label text="TRANG QUẢN TRỊ HỆ THỐNG ĐẤU GIÁ" style="-fx-font-size: 20px;"/>
            <HBox spacing="10.0">
                <Button text="Làm mới danh sách" onAction="#handleRefreshAuctions"/>
            </HBox>
        </VBox>
    </top>
    <center>
        <VBox spacing="14.0" style="-fx-padding: 12;">
            <TableView fx:id="auctionTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="itemNameColumn" prefWidth="230.0" text="Vật phẩm"/>
                    <TableColumn fx:id="sellerColumn" prefWidth="150.0" text="Seller"/>
                    <TableColumn fx:id="categoryColumn" prefWidth="120.0" text="Loại"/>
                    <TableColumn fx:id="currentPriceColumn" prefWidth="140.0" text="Giá hiện tại"/>
                    <TableColumn fx:id="statusColumn" prefWidth="120.0" text="Trạng thái"/>
                    <TableColumn fx:id="endTimeColumn" prefWidth="220.0" text="Kết thúc lúc"/>
                </columns>
            </TableView>
            <HBox spacing="10.0">
                <Button fx:id="startButton" text="Mở phiên" onAction="#handleStartAuction"/>
                <Button fx:id="endButton" text="Kết thúc sớm" onAction="#handleEndAuction"/>
                <Button fx:id="cancelButton" text="Hủy phiên" onAction="#handleCancelAuction"/>
            </HBox>
        </VBox>
    </center>
    <bottom>
        <HBox spacing="10.0" alignment="CENTER_RIGHT" style="-fx-padding: 12;">
            <Button text="Quay lại danh sách vật phẩm" onAction="#handleOpenMarket"/>
        </HBox>
    </bottom>
</BorderPane>
