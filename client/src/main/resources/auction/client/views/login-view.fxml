<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="auction.client.controllers.LoginController"
      alignment="CENTER" spacing="0" style="-fx-background-color: linear-gradient(to bottom, #2196F3, #1976D2);">

  <Region VBox.vgrow="ALWAYS"/>

  <VBox alignment="CENTER" spacing="20" style="-fx-background-color: white; -fx-padding: 40; -fx-border-radius: 8;">
    <padding>
      <Insets top="0" bottom="0" left="0" right="0"/>
    </padding>

    <Label text="🏛️ HỆ THỐNG ĐẤU GIÁ TRỰC TUYẾN"
           style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1976D2; -fx-text-alignment: CENTER;"/>
    <Label text="Đăng nhập để tiếp tục"
           style="-fx-font-size: 14px; -fx-text-fill: #757575; -fx-text-alignment: CENTER;"/>

    <Separator style="-fx-padding: 0;"/>

    <VBox spacing="12">
      <Label text="Tên đăng nhập" style="-fx-font-size: 12px; -fx-font-weight: 600;"/>
      <TextField fx:id="usernameField" promptText="Nhập tên đăng nhập..."
                 style="-fx-font-size: 13px; -fx-padding: 12px; -fx-border-radius: 4; -fx-border-color: #BDBDBD;"/>
    </VBox>

    <VBox spacing="12">
      <Label text="Mật khẩu" style="-fx-font-size: 12px; -fx-font-weight: 600;"/>
      <PasswordField fx:id="passwordField" promptText="Mật khẩu (nếu có)..."
                     style="-fx-font-size: 13px; -fx-padding: 12px; -fx-border-radius: 4; -fx-border-color: #BDBDBD;"/>
    </VBox>

    <HBox spacing="12" alignment="CENTER">
      <Button text="🔓 Đăng nhập" onAction="#handleLogin" prefWidth="140"
              style="-fx-font-size: 14px; -fx-padding: 12px 20px; -fx-background-color: #1976D2; -fx-text-fill: white; -fx-font-weight: 600;"/>
      <Button text="📝 Đăng ký" onAction="#handleRegister" prefWidth="140"
              style="-fx-font-size: 14px; -fx-padding: 12px 20px; -fx-background-color: #FF6F00; -fx-text-fill: white; -fx-font-weight: 600;"/>
    </HBox>

    <Label text="Hệ thống hỗ trợ: ADMIN, SELLER, BIDDER"
           style="-fx-font-size: 11px; -fx-text-fill: #9E9E9E; -fx-text-alignment: CENTER; -fx-padding: 10 0 0 0;"/>
  </VBox>

  <Region VBox.vgrow="ALWAYS"/>
</VBox>
