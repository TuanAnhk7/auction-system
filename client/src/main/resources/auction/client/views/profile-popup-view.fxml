<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="260.0" prefWidth="400.0"
            xmlns="http://javafx.com/javafx/8"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="auction.client.controllers.ProfilePopupController"
            style="-fx-background-color: #f8fafc;">
    <top>
        <VBox spacing="6.0" style="-fx-padding: 18 18 6 18;">
            <Label text="THÔNG TIN CÁ NHÂN" style="-fx-font-size: 18px; -fx-font-weight: bold;" />
            <Label fx:id="statusLabel" text="Nhập số tiền và bấm Nạp tiền để cộng vào số dư."
                   wrapText="true" style="-fx-text-fill: #64748b;" />
        </VBox>
    </top>
    <center>
        <GridPane hgap="12.0" vgap="12.0" style="-fx-padding: 8 18 8 18;">
            <columnConstraints>
                <ColumnConstraints minWidth="110.0" halignment="RIGHT" />
                <ColumnConstraints hgrow="ALWAYS" />
            </columnConstraints>
            <Label text="Tên tài khoản:" GridPane.rowIndex="0" GridPane.columnIndex="0" />
            <Label fx:id="usernameValueLabel" GridPane.rowIndex="0" GridPane.columnIndex="1" />
            <Label text="Số dư hiện tại:" GridPane.rowIndex="1" GridPane.columnIndex="0" />
            <Label fx:id="balanceValueLabel" GridPane.rowIndex="1" GridPane.columnIndex="1" />
            <Label text="Số tiền nạp:" GridPane.rowIndex="2" GridPane.columnIndex="0" />
            <TextField fx:id="depositAmountField" promptText="Ví dụ: 500"
                       GridPane.rowIndex="2" GridPane.columnIndex="1" />
        </GridPane>
    </center>
    <bottom>
        <HBox alignment="CENTER_RIGHT" spacing="10.0" style="-fx-padding: 0 18 18 18;">
            <Button text="Đóng" onAction="#handleClose" />
            <Button text="Nạp tiền" defaultButton="true" onAction="#handleDeposit" />
        </HBox>
    </bottom>
</BorderPane>
