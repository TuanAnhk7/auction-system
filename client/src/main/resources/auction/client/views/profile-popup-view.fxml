<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane prefHeight="320.0" prefWidth="450.0"
            style="-fx-background-color: linear-gradient(to bottom, #2196F3, #1976D2); -fx-padding: 15;"
            xmlns="http://javafx.com/javafx/8"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="auction.client.controllers.ProfilePopupController">

    <center>
        <VBox style="-fx-background-color: white; -fx-background-radius: 8; -fx-padding: 20;" spacing="15.0">

            <VBox spacing="6.0" alignment="CENTER">
                <Label text="👤 THÔNG TIN CÁ NHÂN" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1976D2;" />
                <Label fx:id="statusLabel" text="Nhập số tiền và bấm Nạp tiền để cộng vào số dư."
                       wrapText="true" style="-fx-text-fill: #757575; -fx-font-size: 13px; -fx-text-alignment: CENTER;" />
                <Separator style="-fx-padding: 10 0 5 0;"/>
            </VBox>

            <GridPane hgap="15.0" vgap="18.0" alignment="CENTER">
                <columnConstraints>
                    <ColumnConstraints minWidth="120.0" halignment="RIGHT" />
                    <ColumnConstraints hgrow="ALWAYS" />
                </columnConstraints>

                <Label text="Tên tài khoản:" style="-fx-font-size: 14px; -fx-text-fill: #757575; -fx-font-weight: bold;"
                       GridPane.rowIndex="0" GridPane.columnIndex="0" />
                <Label fx:id="usernameValueLabel" text="---" style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #333333;"
                       GridPane.rowIndex="0" GridPane.columnIndex="1" />

                <Label text="Số dư hiện tại:" style="-fx-font-size: 14px; -fx-text-fill: #757575; -fx-font-weight: bold;"
                       GridPane.rowIndex="1" GridPane.columnIndex="0" />
                <Label fx:id="balanceValueLabel" text="0.00 $" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #FF6F00;"
                       GridPane.rowIndex="1" GridPane.columnIndex="1" />

                <Label text="Số tiền nạp:" style="-fx-font-size: 14px; -fx-text-fill: #757575; -fx-font-weight: bold;"
                       GridPane.rowIndex="2" GridPane.columnIndex="0" />
                <TextField fx:id="depositAmountField" promptText="Ví dụ: 500"
                           style="-fx-font-size: 14px; -fx-padding: 8 12; -fx-border-color: #BDBDBD; -fx-border-radius: 4; -fx-background-radius: 4;"
                           GridPane.rowIndex="2" GridPane.columnIndex="1" />
            </GridPane>

            <Region VBox.vgrow="ALWAYS" />

            <HBox alignment="CENTER_RIGHT" spacing="12.0">
                <Button text="❌ Đóng" onAction="#handleClose" prefWidth="100.0"
                        style="-fx-background-color: #F5F5F5; -fx-text-fill: #757575; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 8 15; -fx-background-radius: 4; -fx-border-color: #E0E0E0; -fx-border-radius: 4; -fx-cursor: hand;" />

                <Button text="💳 Nạp tiền" defaultButton="true" onAction="#handleDeposit" prefWidth="120.0"
                        style="-fx-background-color: #1976D2; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 9 15; -fx-background-radius: 4; -fx-cursor: hand;" />
            </HBox>

        </VBox>
    </center>
</BorderPane>