<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="640.0" prefWidth="1120.0"
            xmlns="http://javafx.com/javafx/8"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="auction.client.controllers.AuctionListController">
  <top>
    <VBox spacing="10.0" style="-fx-padding: 10;">
      <Label text="DANH SÁCH VẬT PHẨM ĐẤU GIÁ" style="-fx-font-size: 20px;" />
      <HBox spacing="10.0" alignment="CENTER_LEFT">
        <TextField fx:id="searchField" promptText="Tìm theo tên vật phẩm, người tạo, người dẫn đầu..." prefWidth="340.0" />
        <ComboBox fx:id="statusFilterComboBox" prefWidth="150.0" promptText="Lọc trạng thái" />
        <ComboBox fx:id="sortComboBox" prefWidth="190.0" promptText="Sắp xếp" />
        <Region HBox.hgrow="ALWAYS" />
        <Label fx:id="balanceLabel" text="Số dư: 0.00 USD" style="-fx-font-weight: bold; -fx-text-fill: #059669; -fx-font-size: 16px;" />
      </HBox>
    </VBox>
  </top>
  <center>
    <SplitPane dividerPositions="0.78">
      <items>
        <TableView fx:id="auctionTable">
          <columns>
            <TableColumn fx:id="nameColumn" prefWidth="220.0" text="Tên vật phẩm" />
            <TableColumn fx:id="artistColumn" prefWidth="170.0" text="Người tạo" />
            <TableColumn fx:id="statusColumn" prefWidth="110.0" text="Trạng thái" />
            <TableColumn fx:id="leaderColumn" prefWidth="150.0" text="Người dẫn đầu" />
            <TableColumn fx:id="endTimeColumn" prefWidth="170.0" text="Kết thúc lúc" />
            <TableColumn fx:id="timeRemainingColumn" prefWidth="120.0" text="Còn lại" />
            <TableColumn fx:id="priceColumn" prefWidth="140.0" text="Giá hiện tại" />
          </columns>
        </TableView>
        <ListView fx:id="bidHistoryListView" prefWidth="220.0" />
      </items>
    </SplitPane>
  </center>
  <bottom>
    <HBox alignment="CENTER" spacing="20" style="-fx-padding: 15;">
      <TextField fx:id="bidAmountField" promptText="Nhập giá đặt" prefWidth="160.0" />
      <Button text="Đấu giá" onAction="#handleBid" />
      <Button text="Làm mới" onAction="#handleRefresh" />
    </HBox>
  </bottom>
</BorderPane>
